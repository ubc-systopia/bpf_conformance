# Using a scalar value as the base of a memory access.

# Linux: reject
# Alivio: reject
# Prevail: reject
-- asm
mov %r1, 0
ldxdw %r0, [%r1]
exit
-- mem
00
-- verifier
reject
-- rejection reason
(R1 invalid mem access 'scalar')|(Unsafe generic load)|(Invalid type)
