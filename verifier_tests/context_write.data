# XDP programs may read selected xdp_md fields but may not write data directly
# into the context object.
-- asm
stw [%r6], 0
mov %r0, 0
exit
-- mem
00
-- verifier
reject
-- verifier reason
(Unsafe ctx access)|(Cannot write to context pointer field)
