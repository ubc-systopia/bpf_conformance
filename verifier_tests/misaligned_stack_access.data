# An eight-byte stack store at fp-4 is not naturally aligned.

# Linux: reject
# Alivio: reject
# Prevail: reject
-- asm
mov %r0, 1
stxdw [%r10-4], %r0
exit
-- mem
00
-- verifier
reject
-- verifier reason
(misaligned stack access)|(Misaligned offset)|(Upper bound must be at most total_stack_size)
