# Stack accesses must use negative offsets from R10
# R10+0 is outside the writable stack region.

# Linux: reject
# Alivio: reject
# Prevail: reject
-- asm
stdw [%r10], 0
mov %r0, 0
exit
-- mem
00
-- verifier
reject
-- rejection reason
(invalid write to stack R10)|(Stack out of bounds)|(Upper bound must be at most total_stack_size)
