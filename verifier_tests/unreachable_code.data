# Expected to be rejected by the Linux verifier due to unreachable code
# However, both Alivio and Prevail are accepting the code
-- asm
lddw %r0, 0
ja done
lddw %r0, 1
lddw %r0, 2
lddw %r0, 3
done:
exit
-- mem
00
-- verifier
reject
-- verifier reason
unreachable insn 12