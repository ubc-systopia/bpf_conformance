# Jump to the end of the program, causing unreachable code.

# Linux: reject
# Alivio: accept
# Prevail: accept
-- asm
lddw %r0, 0
ja done
lddw %r0, 1
lddw %r0, 2
lddw %r0, 3
done:
exit
-- mem
00
-- verifier
reject
-- rejection reason
unreachable insn 12
